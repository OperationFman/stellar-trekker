{
	"AWSTemplateFormatVersion": "2010-09-09",
	"Transform": "AWS::Serverless-2016-10-31",
	"Description": "Backend Lambda function with API Gateway",
	"Resources": {
		"Get": {
			"Type": "AWS::Serverless::Function",
			"Properties": {
				"Handler": "InventoryManager:: InventoryManager. Functions::Get",
				"Runtime": "dotnet8",
				"CodeUri": "",
				"MemorySize": 256,
				"Timeout": 30,
				"Role": null,
				"Policies": [
					"AWSLambdaBasic ExecutionRole"
				],
				"Events": {
					"PutResource": {
						"Type": "Api",
						"Properties": {
							"Path": "/",
							"Method": "GET"
						}
					}
				}
			}
		},
		"Outputs": {
			"ApiURL": {
				"Value": {
					"Fn::Sub ": "https://${ServerlessRestApi}.execute-api.${AWS::Region}.amazonaws.com/Prod/"
				}
			}
		}
	}
}
